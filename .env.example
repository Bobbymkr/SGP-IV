# Adaptive Traffic Signal Timer - Environment Variables
# Copy this file to .env and modify as needed

# Application
APP_NAME="Adaptive Traffic Signal Timer"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Streamlit Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# Database
DATABASE_URL=sqlite+aiosqlite:///./adaptive_traffic.db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Computer Vision / ML
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45
DEVICE=auto
BATCH_SIZE=1

# Traffic Simulation
SIMULATION_ENABLED=true
SIMULATION_TIME=300
NUM_SIGNALS=4
DEFAULT_GREEN_TIME=20
DEFAULT_YELLOW_TIME=5
DEFAULT_RED_TIME=150

# Signal Control
CONTROLLER_TYPE=dqn
MIN_GREEN_TIME=10
MAX_GREEN_TIME=60
DETECTION_TIME=5

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["*"]

# External Services (optional)
SENTRY_DSN=
GRAFANA_URL=
GRAFANA_API_KEY=
# File Storage
DATA_DIR=./data
MODELS_DIR=./data/models
LOGS_DIR=./logs


# NTCIP / J2735 V2X
NTCIP_CONTROLLER_IP=127.0.0.1
NTCIP_STMP_PORT=5000
NTCIP_SNMP_PORT=161
NTCIP_COMMUNITY=public
NTCIP_SNMP_COMMUNITY=public
NTCIP_TIMEOUT=5.0
NTCIP_MAX_RETRIES=3
NTCIP_TRANSPORT=both

J2735_BSM_PORT=1735
J2735_SPAT_PORT=1736
J2735_BROADCAST_IP=255.255.255.255
J2735_TX_POWER_DBM=20
J2735_TRANSMIT_INTERVAL=0.1
J2735_MAX_BSM_AGE=1.0

# City Profile
CITY_PROFILE=tier2_default


# Free Frontier Pool - freelm 6-provider failover (all hats share one .env inside Orca)
# freelm auto-rotates: Groq -> Cerebras -> Gemini -> NVIDIA -> OpenRouter -> GitHub Models
# Get keys (no card): freelm.net/config | aistudio.google.com/app/apikey | console.groq.com/keys
# cloud.cerebras.ai | console.mistral.ai/api-keys | build.nvidia.com | openrouter.ai/settings/keys

GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=

# Single Brain - GraphMem + Obsidian vault (Orca workspace)
GRAPH_MEM_DIR=.graph-mem
VAULT_DIR=vault
ORCA_PIPELINE=orca-pipeline.yaml
