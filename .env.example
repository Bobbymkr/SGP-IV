# Adaptive Traffic Signal Timer - Environment Variables
# Copy this file to .env and modify as needed

# Application
APP_NAME="Adaptive Traffic Signal Timer"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Streamlit Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# Database
DATABASE_URL=sqlite+aiosqlite:///./adaptive_traffic.db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Computer Vision / ML
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45
DEVICE=auto
BATCH_SIZE=1

# Traffic Simulation
SIMULATION_ENABLED=true
SIMULATION_TIME=300
NUM_SIGNALS=4
DEFAULT_GREEN_TIME=20
DEFAULT_YELLOW_TIME=5
DEFAULT_RED_TIME=150

# Signal Control
CONTROLLER_TYPE=dqn
MIN_GREEN_TIME=10
MAX_GREEN_TIME=60
DETECTION_TIME=5

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["*"]

# External Services (optional)
SENTRY_DSN=
GRAFANA_URL=
GRAFANA_API_KEY=

# File Storage
DATA_DIR=./data
MODELS_DIR=./data/models
LOGS_DIR=./logs